{
  "compilerOptions": {
    "target": "es5",
    "ignoreDeprecations": "6.0",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"],
      "@codeforge/trpc": ["../../packages/trpc/index.ts"],
      "@codeforge/trpc/*": ["../../packages/trpc/*"],
      "@trpc/react-query": ["../../packages/trpc/node_modules/@trpc/react-query"],
      "@trpc/react-query/*": ["../../packages/trpc/node_modules/@trpc/react-query/*"],
      "@trpc/client": ["../../packages/trpc/node_modules/@trpc/client"],
      "@trpc/client/*": ["../../packages/trpc/node_modules/@trpc/client/*"],
      "@tanstack/react-query": ["../../packages/trpc/node_modules/@tanstack/react-query"],
      "@tanstack/react-query/*": ["../../packages/trpc/node_modules/@tanstack/react-query/*"],
      "@trpc/server": ["../../packages/trpc/node_modules/@trpc/server"],
      "@trpc/server/*": ["../../packages/trpc/node_modules/@trpc/server/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
